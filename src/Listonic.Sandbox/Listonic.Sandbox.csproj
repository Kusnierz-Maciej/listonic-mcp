<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <RootNamespace>Listonic.Sandbox</RootNamespace>
        <AssemblyName>Listonic.Sandbox</AssemblyName>
        <!-- Reuse the live tests' user-secrets store so Listonic:Email / Listonic:Password
             are the same creds ListonicApiClient.Tests already uses. -->
        <UserSecretsId>listonic-api-client-tests</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ListonicApiClient\ListonicApiClient.csproj" />
        <ProjectReference Include="..\ListonicMcp\ListonicMcp.csproj" />
    </ItemGroup>

</Project>
