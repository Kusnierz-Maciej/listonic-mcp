{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "ModelContextProtocol": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "RequireMcpApiKey": true
  },
  "OAuth": {
    "AuthorizationCodeLifetime": "00:01:00",
    "AccessTokenLifetime": "01:00:00",
    "RefreshTokenLifetime": "365.00:00:00"
  },
  "RateLimit": {
    "TokenLimit": 15,
    "ReplenishmentPeriod": "00:00:00.5"
  },
  "Prompts": {
    "Enabled": true
  },
  "Telemetry": {
    "Enabled": false,
    "OtlpEndpoint": "http://localhost:4317"
  }
}
