<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Version>1.3.2</Version>
    </PropertyGroup>

    <PropertyGroup>
        <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-alpine</ContainerBaseImage>
        <ContainerRepository>listonic-mcp</ContainerRepository>
    </PropertyGroup>

    <ItemGroup>
        <ContainerPort Include="8080" Type="tcp" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ModelContextProtocol.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ListonicApiClient\ListonicApiClient.csproj" />
    </ItemGroup>

</Project>
