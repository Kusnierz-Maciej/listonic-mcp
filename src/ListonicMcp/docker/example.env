# Listonic credentials — required
Listonic__Email=your@email.com
Listonic__Password=yourpassword

# MCP API key — required in production
# Set to a long random string; configure the same value in your Claude Code MCP config:
#   "headers": { "Authorization": "Bearer <this-value>" }
# Leave empty to disable authentication (dev mode only).
Security__ApiKey=change-me-to-a-long-random-string
