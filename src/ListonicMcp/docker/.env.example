# Secret settings for listonic-mcp (loaded via env_file in docker-compose).
# Non-secret settings (logging, telemetry, API-key requirement) live in docker-compose.*.yml.
# If a value contains $, escape each one as $$ (Docker Compose variable interpolation).

# ── Authentication ──────────────────────────────────────────────────────────
# Clients reach /mcp one of two ways:
#   1. OAuth 2.1 — the client runs the sign-in flow; the user enters an API key (below) plus
#      their own Listonic email + password on the sign-in page. Nothing Listonic-specific is stored here.
#   2. Headers — X-Api-Key (a key from the allowlist below) + Authorization: Basic base64(email:password).
#
# There is NO server-side default Listonic account: every HTTP caller brings their own credentials.

# API keys allowed to sign in (OAuth) and to use the X-Api-Key header. Any long random string works —
# a GUID is a good choice:  uuidgen  (macOS/Linux)  or  [guid]::NewGuid()  (PowerShell).
# Add one per user; remove one and restart to end every session created with it.
# (Not needed if Security__RequireMcpApiKey=false in the compose file.)
Security__AllowedApiKeys__0=change-me-to-a-guid-or-long-random-string
# Security__AllowedApiKeys__1=another-key-for-a-second-user

# Secret that secures OAuth session tokens. REQUIRED. Must be a long random value (min 32 chars)
# and kept STABLE — changing it invalidates every issued token (all users must sign in again).
# The server refuses to start if it is unset, too short, or left at this placeholder.
# Generate one with:  openssl rand -base64 48
Security__TokenSecret=change-me-to-a-long-random-secret
