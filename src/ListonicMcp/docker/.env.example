# Listonic credentials — optional when using per-request headers (multi-account mode)
# When set, these are used as a fallback for clients that don't send an Authorization: Basic header.
# If your password contains $, escape each one as $$  (Docker Compose variable interpolation)
Listonic__Email=your@email.com
Listonic__Password=yourpassword

# MCP API key — required in production
# Any long random string works — a GUID is a good choice.
# Generate one with:  uuidgen  (macOS/Linux)  or  [guid]::NewGuid()  (PowerShell)
# Configure the same value in your MCP client config:
#   "headers": { "X-Api-Key": "<this-value>" }
# Leave empty to disable authentication (dev mode only).
Security__ApiKey=change-me-to-a-guid-or-long-random-string
